{
  "name": "casa-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "knip": "knip --include dependencies,unlisted,files",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:migrate:status": "node scripts/db/migrate.mjs --status",
    "db:baseline": "node scripts/db/migrate.mjs --baseline=0001",
    "db:seed": "node scripts/db/apply-sql-directory.mjs db/seeds"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-list": "^2.4.1",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/country-list": "^2.1.4",
    "@types/node": "^26",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "playwright": "^1.58.2",
    "postcss": "^8.5.26",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vitest": "^4.0.18"
  }
}
