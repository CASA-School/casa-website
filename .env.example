NEXT_PUBLIC_SHOW_DRAFT_CLAIMS=false

# ---------------------------------------------------------------- database
#
# Required by the staff workspace at /admin, which has no fixture fallback
# (docs/ADMIN_WORKSPACE.md). Optional for the public site, which falls back to
# in-repo fixtures — except career application submission, because CV uploads
# are stored in Postgres.
#
# Local: `npm run db:up` starts Postgres 17 in Docker on port 5433.
# DATABASE_URL=postgres://casa:casa_local_dev@127.0.0.1:5433/casa
#
# Managed (Azure Flexible Server, Neon):
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Connection pool size. Defaults to 5, which is deliberately small: an Azure
# B1ms Flexible Server allows roughly 50 connections in total.
# ADMIN_DB_POOL_MAX=5

# ----------------------------------------------------------- host routing
#
# The workspace answers on admin.casa-bremen.de and 404s under /admin on the
# public host in production (src/proxy.ts). Set this to reopen it there — for
# the window between deploying the container and pointing the admin DNS record
# at it, and no longer.
# CASA_ALLOW_ADMIN_ON_PUBLIC_HOST=false

# Internal review surfaces (/design-system, /design-alternatives, ...). Open on
# local dev and previews, closed on a production build.
# CASA_ENABLE_INTERNAL_SURFACES=false

# ------------------------------------------------------------- webhooks
#
# All optional. Each fires ALONGSIDE storing the record in the workspace, never
# instead of it — see docs/ADMIN_WORKSPACE.md, "Data flow from the public site".
#
# COURSE_REGISTRATION_WEBHOOK_URL=https://example.com/course-registration
# EXAM_REGISTRATION_WEBHOOK_URL=https://example.com/exam-registration
# CONTACT_WEBHOOK_URL=https://example.com/contact
# GROUP_INQUIRY_WEBHOOK_URL=https://example.com/group-inquiry
# CAREERS_APPLICATION_WEBHOOK_URL=https://example.com/careers
#
# Predates the workspace. Placement review now happens at /admin/placement, so
# this is only needed if another CASA system also wants the hand-off.
# PLACEMENT_RESULT_WEBHOOK_URL=https://example.com/placement-result
