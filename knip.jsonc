{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // Files that are deliberately staged ahead of the UI that will consume them.
  //
  // Each entry needs a removal condition, so an ignore cannot quietly become
  // permanent. Delete the line as soon as its condition is met — knip failing
  // again is the point, not a regression.
  //
  // Currently empty: `special-course-modules.ts` was ignored here until work
  // board U6 landed, and is now imported by
  // `src/components/courses/special-course-catalogue.tsx`.
  "ignore": [
    // Operator scripts, run by hand against a DATABASE_URL rather than
    // imported. `seed-demo.mjs` fills the staff workspace with plausible
    // records for a design review or a demo; it deliberately does NOT live in
    // `db/seeds/`, because that directory is applied to real databases and
    // fake people do not belong in a real queue (docs/ADMIN_WORKSPACE.md).
    //
    // Removal condition: delete when CASA has real traffic in the workspace
    // and nobody needs a populated demo any more.
    "scripts/admin/seed-demo.mjs",

    // Loads the course-planning tables from the JSON files the analytics
    // bridge publishes (courses, weekly teacher assignments, staff absences,
    // staff). Run by hand against a DATABASE_URL, never imported.
    //
    // Removal condition: delete when the workspace reads FileMaker directly
    // (docs/FILEMAKER_BRIDGE.md §7, item 7) and this script is retired.
    "scripts/kursplanung/import-bridge.mjs",

    // Writes SchoolMan's active staff into the staff register, from
    // scripts/filemaker/read_staff.py through a pipe (docs/ADMIN_WORKSPACE.md
    // §Staff). Run by hand on the office Mac, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings staff across
    // (docs/FILEMAKER_BRIDGE.md) and this script is retired.
    "scripts/filemaker/import-staff.mjs",

    // Writes SchoolMan's courses still running or ahead into `courses`, from
    // scripts/filemaker/read_courses.py through a pipe (docs/ADMIN_WORKSPACE.md
    // §Courses). Run by hand on the office Mac, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings courses across.
    "scripts/filemaker/import-courses.mjs",

    // Writes SchoolMan's weekly plans and lesson days of those courses into
    // `course_week_plans` and `course_days`, from
    // scripts/filemaker/read_lesson_days.py through a pipe (docs/ADMIN_WORKSPACE.md
    // §Lesson days). Run by hand on the office Mac, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings lesson days across.
    "scripts/filemaker/import-lesson-days.mjs",

    // Writes SchoolMan's learners per course and week (counts only) into
    // `course_week_learners`, from scripts/filemaker/read_course_learners.py
    // through a pipe (docs/ADMIN_WORKSPACE.md §Courses). Run by hand, never imported.
    //
    // Removal condition: delete when bookings are made in the workspace alone.
    "scripts/filemaker/import-course-learners.mjs",

    // Writes SchoolMan's staff absences (ill and holiday days) into
    // `staff_absences`, from scripts/filemaker/read_absences.py through a pipe
    // (docs/ADMIN_WORKSPACE.md §Staff). Run by hand, never imported.
    //
    // Removal condition: delete when absences are entered in the workspace alone.
    "scripts/filemaker/import-absences.mjs",

    // Writes some of SchoolMan's learners (people, contact, bookings and
    // periods) into the workspace, from scripts/filemaker/read_learners.py
    // through a pipe (docs/ADMIN_WORKSPACE.md §Learners from SchoolMan). Run
    // by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings learners across.
    "scripts/filemaker/import-learners.mjs",

    // Writes the agencies and companies the learner sample depends on into
    // `organisations` (contacts, commission terms, who pays a booking), from
    // scripts/filemaker/read_organisations.py through a pipe
    // (docs/ADMIN_WORKSPACE.md §Organisations). Run by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings organisations across.
    "scripts/filemaker/import-organisations.mjs",

    // Writes SchoolMan's group visits into `group_visits` (their comments and
    // work log; links the participants' bookings and the group's courses),
    // from scripts/filemaker/read_groups.py through a pipe
    // (docs/ADMIN_WORKSPACE.md §Groups). Run by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings group visits across.
    "scripts/filemaker/import-groups.mjs",

    // Writes SchoolMan's offers into `offers` (lines, letters, comments, work
    // log), from scripts/filemaker/read_offers.py through a pipe
    // (docs/OFFERS.md §From SchoolMan). Run by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings offers across.
    "scripts/filemaker/import-offers.mjs",

    // Writes SchoolMan's places to stay into `accommodations` (family, rooms,
    // group reservations) and places the learners' stays, from
    // scripts/filemaker/read_accommodation.py through a pipe
    // (docs/ADMIN_WORKSPACE.md §Accommodation). Run by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings accommodation across.
    "scripts/filemaker/import-accommodation.mjs",

    // Writes SchoolMan's follow-up dates onto the bookings that came across,
    // from scripts/filemaker/read_follow_ups.py through a pipe
    // (docs/ADMIN_WORKSPACE.md §Follow-ups). Run by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings follow-ups across.
    "scripts/filemaker/import-follow-ups.mjs",

    // Writes the rest of SchoolMan's learner ledger (payment plans, commission
    // per charge, payouts, invoice numbers, invoices), from
    // scripts/filemaker/read_money.py through a pipe (docs/ADMIN_WORKSPACE.md
    // §Money from SchoolMan). Run by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings money across.
    "scripts/filemaker/import-money.mjs",

    // Writes the Klassenbuch's attendance, as SchoolMan holds it, beside the
    // sample's bookings, from scripts/filemaker/read_attendance.py through a
    // pipe (docs/ADMIN_WORKSPACE.md §Attendance). Run by hand, never imported.
    //
    // Removal condition: delete when the workspace reads attendance from the Klassenbuch.
    "scripts/filemaker/import-attendance.mjs",

    // Writes how the sample's learners came in (pre-bookings as notes, the
    // waiting-list rows that name a course here), from
    // scripts/filemaker/read_intake.py through a pipe (docs/schoolman/intake.md).
    // Run by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings intake across.
    "scripts/filemaker/import-intake.mjs",

    // Writes SchoolMan's letters to hosts, how each letter went out, and the
    // complaints, from scripts/filemaker/read_letters_extra.py through a pipe
    // (docs/schoolman/letters-and-history.md). Run by hand, never imported.
    //
    // Removal condition: delete when the FileMaker bridge brings letters across.
    "scripts/filemaker/import-letters-extra.mjs",

    // A SchoolMan letter in the workspace's letter shape, shared by the two
    // imports above that bring letters (learners, offers); imported only by
    // them, which knip does not follow.
    //
    // Removal condition: delete with the last of those imports.
    "scripts/filemaker/letter-document.mjs",

    // Crawls the running site for every photo box; the input of
    // scripts/media/fit_positions.py (docs/MEDIA_LIBRARY.md, crop pass). Run by
    // hand against a dev server, never imported.
    //
    // Removal condition: delete when photo positions are checked in CI instead.
    "scripts/media/crop_audit.mjs",

    // Reached only through the `server-only` alias in vitest.config.ts, which
    // knip does not follow. See the comment there: the real package throws from
    // its browser entry point, which every jsdom suite that transitively
    // imports the database layer would hit on import.
    //
    // Removal condition: delete when `server-only` is no longer imported by
    // `src/lib/admin/db.ts`, or when knip resolves vitest aliases.
    "src/test/server-only-stub.ts"
  ]
}
